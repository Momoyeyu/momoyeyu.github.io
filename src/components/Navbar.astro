---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		const link = typeof item === "number" ? LinkPresets[item] : item;
		return !link.external && link.url === "/" && siteConfig.lang === "zh_CN"
			? { ...link, name: "首页" }
			: link;
	},
);

const isGitHub = (link: NavBarLink) =>
    link.external && link.name.toLowerCase() === "github";
const navigationLinks = links.filter(link => !isGitHub(link));
const gitHubLinks = links.filter(isGitHub);
const normalizePath = (pathname: string) => pathname.replace(/\/+$/, "") || "/";
const currentPath = normalizePath(Astro.url.pathname);
const isCurrentLink = (link: NavBarLink) => {
    if (link.external) return false;
    const path = normalizePath(url(link.url));
    return currentPath === path || (link.url !== "/" && currentPath.startsWith(`${path}/`));
};
---
<div id="navbar" class="z-50 onload-animation">
    <div class="absolute h-8 left-0 right-0 -top-8 bg-[var(--card-bg)] transition"></div> <!-- used for onload animation -->
    <div class:list={[
        className,
        "navbar-shell card-base !overflow-visible max-w-[var(--page-width)] h-[4.5rem] !rounded-t-none mx-auto"]}>
        <a href={url('/')} class="navbar-brand btn-plain scale-animation active:scale-95" title={siteConfig.title}>
            <span class="navbar-brand-name">{siteConfig.title}</span>
        </a>
        <nav class="navbar-links hidden md:flex">
            {navigationLinks.map((l) => {
                return <a aria-label={l.name} title={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
                          rel={l.external ? "noopener noreferrer" : null}
                          aria-current={isCurrentLink(l) ? "page" : null}
                          class="navbar-link btn-plain scale-animation active:scale-95"
                >
                    <span>{l.name}</span>
                    {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="navbar-external-icon" aria-hidden="true" />}
                </a>;
            })}
        </nav>
        <div class="navbar-actions">
            {gitHubLinks.length > 0 && <div class="navbar-external-actions">
                {gitHubLinks.map(link => (
                    <a href={link.url} aria-label={link.name} title={link.name} target="_blank" rel="noopener noreferrer"
                        class="navbar-action navbar-github btn-plain scale-animation rounded-lg h-11 w-11 active:scale-95">
                        <Icon name="fa6-brands:github" class="text-[1.25rem]" aria-hidden="true" />
                    </a>
                ))}
            </div>}
            <Search client:load></Search>
            <LightDarkSwitch client:load></LightDarkSwitch>
            <button type="button" aria-label="Menu" title="Menu" name="Nav Menu" class="navbar-action btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 md:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>
        <NavMenuPanel links={links}></NavMenuPanel>
    </div>
</div>

<style>
.navbar-shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-inline: 0.75rem;
}

.navbar-brand {
    min-width: 0;
    min-height: 2.75rem;
    padding-inline: 0.625rem;
    border-radius: 0.75rem;
}

.navbar-brand-name {
    overflow: hidden;
    color: var(--primary);
    font-family: var(--font-display, inherit);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: 0.025em;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.navbar-links {
    flex-shrink: 0;
    align-items: center;
    gap: 0.125rem;
    margin-left: auto;
}

.navbar-link {
    width: 4rem;
    flex-shrink: 0;
    min-height: 2.75rem;
    gap: 0.375rem;
    padding: 0;
    border-radius: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    white-space: nowrap;
}

.navbar-link::after {
    position: absolute;
    bottom: 0.375rem;
    left: 50%;
    width: 1.5em;
    height: 1px;
    background: var(--primary);
    content: "";
    opacity: 0;
    transform: translateX(-50%) scaleX(0.5);
    transition: opacity 150ms ease, transform 150ms ease;
}

.navbar-link[aria-current="page"] {
    color: var(--primary);
}

.navbar-link[aria-current="page"]::after {
    opacity: 1;
    transform: translateX(-50%) scaleX(1);
}

.navbar-external-icon {
    font-size: 0.75rem;
    opacity: 0.4;
}

.navbar-actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.125rem;
}

.navbar-external-actions {
    display: flex;
    align-items: center;
    padding-right: 0.375rem;
    margin-right: 0.375rem;
    border-right: 1px solid var(--line-divider);
}

.navbar-brand:focus-visible,
.navbar-link:focus-visible,
.navbar-action:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
}

@media (min-width: 768px) {
    .navbar-shell {
        gap: 0.75rem;
        padding-inline: 1.125rem;
    }

    .navbar-brand-name {
        font-size: 1.25rem;
    }
}

@media (min-width: 1280px) {
    .navbar-shell {
        gap: 1.25rem;
        padding-inline: 1.5rem;
    }
}
</style>

<script>
function loadButtonScript() {
    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }
}

loadButtonScript();

function syncCurrentNavigation() {
    const normalizePath = (pathname: string) => pathname.replace(/\/+$/, "") || "/";
    const currentPath = normalizePath(window.location.pathname);
    const homePath = normalizePath(new URL(import.meta.env.BASE_URL, window.location.origin).pathname);
    document.querySelectorAll<HTMLAnchorElement>("#navbar .navbar-link, #nav-menu-panel a[href]").forEach(link => {
        const path = normalizePath(link.pathname);
        const current = link.origin === window.location.origin &&
            (currentPath === path || (path !== homePath && currentPath.startsWith(`${path}/`)));
        if (current) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
    });
}

syncCurrentNavigation();
document.addEventListener("swup:page:view", syncCurrentNavigation);
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
        console.log('Pagefind loaded and initialized successfully, event dispatched.');
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
        console.log('Pagefind load error, event dispatched.');
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
</script>}

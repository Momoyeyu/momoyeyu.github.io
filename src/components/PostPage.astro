---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import PostCardGrid from "./PostCardGrid.astro";
import PostLayoutSwitch from "./PostLayoutSwitch.svelte";

const { page, pinnedPosts = [] } = Astro.props;

const pinned = pinnedPosts as CollectionEntry<"posts">[];
const rest = page.data as CollectionEntry<"posts">[];
const layoutLabels = { grid: i18n(I18nKey.gridView), list: i18n(I18nKey.listView) };

let delay = 0;
const interval = 50;
---
{pinned.length > 0 && (
    <section class="mb-8">
        <div class="feed-section-heading flex items-center gap-2 mb-4 onload-animation" style={`animation-delay: calc(var(--content-delay) + ${delay * interval}ms);`}>
            <h2 class="text-sm font-semibold text-75">
                {i18n(I18nKey.pinnedPosts)}
            </h2>
            <Icon name="fa6-solid:thumbtack" class="text-[var(--primary)] text-[0.65rem]" />
            <PostLayoutSwitch labels={layoutLabels} client:load />
            <span class="flex-1 h-px bg-[var(--line-divider)] ml-2" aria-hidden="true"></span>
        </div>
        <div class="post-feed transition grid grid-cols-1 md:grid-cols-2 gap-4">
            {pinned.map((entry) => (
                <PostCardGrid
                    entry={entry}
                    title={entry.data.title}
                    tags={entry.data.tags}
                    category={entry.data.category}
                    date={entry.data.date}
                    updated={entry.data.updated}
                    url={getPostUrlBySlug(entry.slug)}
                    image={entry.data.image}
                    description={entry.data.description}
                    draft={entry.data.draft}
                    class:list="onload-animation"
                    style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
                />
            ))}
        </div>
    </section>
)}

{rest.length > 0 && (
    <div class="feed-section-heading pinned-divider flex items-center gap-2 mb-4 onload-animation" style={`animation-delay: calc(var(--content-delay) + ${delay * interval}ms);`}>
        <h2 class="text-sm font-semibold text-75">
            {i18n(I18nKey.latestPosts)}
        </h2>
        {pinned.length === 0 && <PostLayoutSwitch labels={layoutLabels} client:load />}
        <span class="flex-1 h-px bg-[var(--line-divider)] ml-2" aria-hidden="true"></span>
    </div>
)}

<div class="post-feed transition grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
    {rest.map((entry) => (
        <PostCardGrid
            entry={entry}
            title={entry.data.title}
            tags={entry.data.tags}
            category={entry.data.category}
            date={entry.data.date}
            updated={entry.data.updated}
            url={getPostUrlBySlug(entry.slug)}
            image={entry.data.image}
            description={entry.data.description}
            draft={entry.data.draft}
            class:list="onload-animation"
            style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
        />
    ))}
</div>

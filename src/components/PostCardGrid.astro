---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { getCover } from "../utils/cover-utils";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getDir, getTagUrl } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	date: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
}
const {
	entry,
	title,
	url,
	date,
	tags,
	category,
	image,
	description,
	style,
} = Astro.props;
const className = Astro.props.class;
const coverSrc = await getCover(entry.id, image || undefined);
const hasCover = coverSrc !== "";
const { remarkPluginFrontmatter } = await entry.render();
const dateLabel = formatDateToYYYYMMDD(date);
---

<div data-layout-key={`card:${entry.slug}`} class:list={["grid-post-card card-base overflow-hidden relative flex flex-col", className]} style={style}>
    {hasCover && <span class="post-card-hover-image" aria-hidden="true"><ImageWrapper src={coverSrc} basePath={path.join("content/posts/", getDir(entry.id))} alt="" class="w-full h-full" /></span>}
    <div class="post-card-content flex flex-col flex-1 px-5 pt-4 pb-5 gap-3 min-w-0">
        <div class="flex items-baseline justify-between gap-3 min-h-5 text-xs">
            {category ? (
                <a href={getCategoryUrl(category)} aria-label={`${i18n(I18nKey.categories)} · ${category}`}
                    class="post-card-category font-medium truncate text-[var(--primary)] hover:underline underline-offset-4">
                    {category}
                </a>
            ) : <span></span>}
            <time datetime={dateLabel} class="shrink-0 text-50 tabular-nums">{dateLabel}</time>
        </div>
        <h2 class="post-card-title text-90 font-semibold text-lg leading-snug min-h-[2.75em]">
            <a href={url} class="line-clamp-2 hover:text-[var(--primary)]">{title}</a>
        </h2>
        <p class="post-card-description text-75 text-sm leading-relaxed line-clamp-2 flex-1 min-h-[3.25em]">
            {description || remarkPluginFrontmatter.excerpt}
        </p>
        <div class="post-card-foot flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2 pt-3 border-t border-[var(--line-divider)] text-xs text-50">
            <div class="flex flex-wrap gap-x-2 gap-y-1 min-w-0">
                {tags.map(tag => (
                    <a href={getTagUrl(tag)} aria-label={`View all posts with the ${tag.trim()} tag`}
                        class="hover:text-[var(--primary)]">#{tag.trim()}</a>
                ))}
            </div>
            <div class="flex flex-wrap gap-x-3 gap-y-1 tabular-nums">
                <span>{remarkPluginFrontmatter.words} {i18n(I18nKey.wordsCount)}</span>
                <span>{remarkPluginFrontmatter.minutes} {i18n(I18nKey.minutesCount)}</span>
            </div>
        </div>
    </div>
</div>

<style>
.post-card-hover-image { position:absolute;inset:0;z-index:0;pointer-events:none;opacity:0;overflow:hidden;transition:opacity 420ms cubic-bezier(.22,1,.36,1); }
.post-card-hover-image :global(.image-wrapper),.post-card-hover-image :global(img) {width:100%;height:100%;object-fit:cover;}
.post-card-hover-image::after { content:"";position:absolute;inset:0;background:linear-gradient(90deg,var(--page-bg) 0%,color-mix(in srgb,var(--page-bg) 96%,transparent) 22%,color-mix(in srgb,var(--page-bg) 90%,transparent) 50%,color-mix(in srgb,var(--page-bg) 50%,transparent) 82%,color-mix(in srgb,var(--page-bg) 32%,transparent)); }
.grid-post-card:focus-within .post-card-hover-image {opacity:1}
@media(hover:hover){.grid-post-card:hover .post-card-hover-image{opacity:1}}
@media(prefers-reduced-motion:reduce){.post-card-hover-image{transition:none}}
</style>

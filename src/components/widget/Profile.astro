---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
---
<div class="profile-card card-base p-5">
    <div class="flex items-center gap-4">
        <a aria-label={config.name} href={url('/about/')}
            class="profile-avatar block shrink-0 w-16 h-16 overflow-hidden rounded-full active:scale-95">
            <ImageWrapper src={config.avatar || ""} alt="Profile Image of the Author" class="w-full h-full"></ImageWrapper>
        </a>
        <div class="min-w-0">
            <a href={url('/about/')} class="block font-semibold text-lg text-90 hover:text-[var(--primary)]">{config.name}</a>
            <p class="text-50 text-xs leading-relaxed mt-1">{config.bio}</p>
        </div>
    </div>
        <div class="profile-links flex flex-wrap gap-2 mt-4 pt-3 border-t border-[var(--line-divider)]">
            {config.links.length > 1 && config.links.map(item =>
                    <a rel="me noopener noreferrer" aria-label={item.name} title={item.name} href={item.url} target="_blank" class="btn-plain rounded-full h-9 w-9 active:scale-90">
                        <Icon name={item.icon} class="text-lg"></Icon>
                    </a>
            )}
            {config.links.length == 1 && <a rel="me noopener noreferrer" aria-label={config.links[0].name} href={config.links[0].url} target="_blank"
                                            class="btn-plain rounded-lg h-9 gap-2 px-2 text-sm active:scale-95">
                <Icon name={config.links[0].icon} class="text-lg"></Icon>
                {config.links[0].name}
            </a>}
        </div>
</div>


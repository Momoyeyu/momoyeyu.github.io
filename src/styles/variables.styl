/* Five fixed source colors. Theme surfaces and states only mix these sources. */
:root
  --palette-paper #f1f5f9
  --palette-white #ffffff
  --palette-ink #29343e
  --palette-slate #536a80
  --palette-mist #b0c6db
  --radius-large 0.625rem
  --content-delay 150ms
  --accent-chroma 0.055
  --surface-chroma 0.016

/* Define paired light and dark roles without adding new source colors. */
define(vars)
  :root
    for key, value in vars
      {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

define({
  --primary: var(--palette-slate) var(--palette-mist)
  --page-bg: var(--palette-paper) var(--palette-ink)
  --card-bg: var(--palette-white) unquote("color-mix(in srgb, var(--palette-ink) 92%, var(--palette-paper))")
  --card-border: unquote("color-mix(in srgb, var(--palette-slate) 20%, transparent)") unquote("color-mix(in srgb, var(--palette-mist) 20%, transparent)")
  --text-primary: var(--palette-ink) var(--palette-paper)
  --text-secondary: var(--palette-slate) var(--palette-mist)
  --text-muted: var(--palette-slate) var(--palette-mist)
  --art-halo: unquote("color-mix(in srgb, var(--palette-mist) 24%, transparent)") unquote("color-mix(in srgb, var(--palette-slate) 35%, transparent)")
  --setting-track-bg: linear-gradient(to right, var(--palette-paper), var(--palette-mist)) linear-gradient(to right, var(--palette-ink), var(--palette-slate))

  --btn-content: var(--primary)
  --btn-regular-bg: unquote("color-mix(in srgb, var(--palette-mist) 20%, var(--palette-white))") unquote("color-mix(in srgb, var(--palette-mist) 8%, var(--palette-ink))")
  --btn-regular-bg-hover: unquote("color-mix(in srgb, var(--palette-mist) 35%, var(--palette-white))") unquote("color-mix(in srgb, var(--palette-mist) 14%, var(--palette-ink))")
  --btn-regular-bg-active: unquote("color-mix(in srgb, var(--palette-mist) 50%, var(--palette-white))") unquote("color-mix(in srgb, var(--palette-mist) 20%, var(--palette-ink))")
  --btn-plain-bg-hover: var(--btn-regular-bg)
  --btn-plain-bg-active: var(--btn-regular-bg-hover)
  --btn-card-bg-hover: unquote("color-mix(in srgb, var(--palette-paper) 65%, var(--palette-white))") unquote("color-mix(in srgb, var(--palette-mist) 12%, var(--palette-ink))")
  --btn-card-bg-active: var(--btn-regular-bg-active)
  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)
  --deep-text: var(--palette-ink)
  --title-active: var(--primary)

  --line-divider: unquote("color-mix(in srgb, var(--palette-slate) 14%, transparent)") unquote("color-mix(in srgb, var(--palette-mist) 14%, transparent)")
  --line-color: var(--card-border)
  --meta-divider: unquote("color-mix(in srgb, var(--palette-slate) 35%, transparent)") unquote("color-mix(in srgb, var(--palette-mist) 35%, transparent)")
  --shadow-color: unquote("color-mix(in srgb, var(--palette-ink) 10%, transparent)")

  --inline-code-bg: var(--btn-regular-bg)
  --inline-code-color: var(--btn-content)
  --selection-bg: unquote("color-mix(in srgb, var(--palette-mist) 40%, var(--palette-paper))") unquote("color-mix(in srgb, var(--palette-slate) 85%, var(--palette-ink))")
  --codeblock-selection: var(--palette-slate)
  --codeblock-bg: var(--palette-ink)
  --codeblock-topbar-bg: unquote("color-mix(in srgb, var(--palette-ink) 85%, var(--palette-slate))")
  --license-block-bg: unquote("color-mix(in srgb, var(--palette-mist) 12%, var(--palette-white))") var(--codeblock-bg)
  --code-control-bg: var(--palette-slate)
  --code-control-bg-hover: unquote("color-mix(in srgb, var(--palette-slate) 80%, var(--palette-mist))")
  --code-control-bg-active: unquote("color-mix(in srgb, var(--palette-slate) 60%, var(--palette-mist))")
  --link-underline: unquote("color-mix(in srgb, var(--palette-slate) 35%, transparent)") unquote("color-mix(in srgb, var(--palette-mist) 35%, transparent)")
  --link-hover: var(--btn-regular-bg-hover)
  --link-active: var(--btn-regular-bg-active)
  --float-panel-bg: var(--card-bg)

  --scrollbar-bg-light: unquote("color-mix(in srgb, var(--palette-slate) 55%, transparent)")
  --scrollbar-bg-hover-light: unquote("color-mix(in srgb, var(--palette-slate) 70%, transparent)")
  --scrollbar-bg-active-light: var(--palette-slate)
  --scrollbar-bg-dark: unquote("color-mix(in srgb, var(--palette-mist) 55%, transparent)")
  --scrollbar-bg-hover-dark: unquote("color-mix(in srgb, var(--palette-mist) 70%, transparent)")
  --scrollbar-bg-active-dark: var(--palette-mist)
  --scrollbar-bg: var(--scrollbar-bg-light) var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light) var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light) var(--scrollbar-bg-active-dark)
  --color-selection-bar: linear-gradient(to right, var(--palette-slate), var(--palette-mist))
  --display-light-icon: 1 0
  --display-dark-icon: 0 1

  /* Semantic article callouts retain their meaning independently of the site palette. */
  --admonitions-color-tip: oklch(0.7 0.14 180) oklch(0.75 0.14 180)
  --admonitions-color-note: oklch(0.7 0.14 250) oklch(0.75 0.14 250)
  --admonitions-color-important: oklch(0.7 0.14 310) oklch(0.75 0.14 310)
  --admonitions-color-warning: oklch(0.7 0.14 60) oklch(0.75 0.14 60)
  --admonitions-color-caution: oklch(0.6 0.2 25) oklch(0.65 0.2 25)

  --toc-badge-bg: var(--btn-regular-bg)
  --toc-btn-hover: var(--btn-plain-bg-hover)
  --toc-btn-active: var(--btn-plain-bg-active)
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: var(--primary)
})

---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Mascot from "@components/Mascot.astro";
import Navbar from "@components/Navbar.astro";
import HomeOpening from "@components/HomeOpening.svelte";
import ReadingControls from "@components/ReadingControls.svelte";
import SidebarToggle from "@components/SidebarToggle.svelte";
import NavigationDust from "@components/NavigationDust.svelte";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import SideBar from "@components/widget/SideBar.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import RightSidebar from "../components/widget/RightSidebar.astro";
import { siteConfig } from "../config";
import { pathsEqual, url } from "../utils/url-utils";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
	category?: string;
	currentSlug?: string;
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
	category,
	currentSlug,
} = Astro.props;

const isPostPage = !!setOGTypeArticle;
const isHome = pathsEqual(Astro.url.pathname, url("/"));
const hasBannerCredit =
	siteConfig.banner.enable && siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;

const bannerSrc = setOGTypeArticle && banner ? banner : siteConfig.banner.src;
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>

<NavigationDust client:idle />

<!-- Persistent navigation; the opening and page artwork follow Swup navigation. -->
<slot slot="head" name="head"></slot>
<div id="top-row" class="fixed inset-x-0 top-0 z-50 max-w-[var(--page-width)] px-0 md:px-4 mx-auto">
    <div id="navbar-wrapper"><Navbar /></div>
</div>
<div id="home-opening">
    {isHome && <HomeOpening client:load image={siteConfig.banner.src} readLabel={i18n(I18nKey.readArticles)}
        copy={{ intro: i18n(I18nKey.openingDescription), scroll: i18n(I18nKey.openingScrollHint) }} />}
</div>
<div id="page-banner" class:list={{ "page-banner-empty": isHome }}>
    {!isHome && siteConfig.banner.enable && <>
        <ImageWrapper alt="" class="page-banner-image" src={bannerSrc} position={siteConfig.banner.position} />
        <div class="banner-fade absolute bottom-0 inset-x-0 pointer-events-none" aria-hidden="true"></div>
    </>}
</div>

<!-- Main content -->
<div id="main-panel" class="relative w-full z-30">
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative max-w-[var(--page-width)] mx-auto pointer-events-auto">
        <ReadingControls client:load />
        <div id="main-grid" class:list={{ "has-rsb": isPostPage && siteConfig.toc.enable && headings.length > 0 }} class="transition duration-700 w-full left-0 right-0 grid grid-cols-[17.5rem_auto] grid-rows-[auto_1fr_auto] lg:grid-rows-[auto] mx-auto gap-4 px-0 md:px-4">
            <!-- Banner image credit -->
            {hasBannerCredit && <a href={siteConfig.banner.credit.url} id="banner-credit" target="_blank" rel="noopener" aria-label="Visit image source"
                                   class:list={["group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
                                   "px-3 right-4 -top-[3.25rem] bg-black/60 hover:bg-black/70 h-9", {"hover:pr-9 active:bg-black/80": hasBannerLink}]}
            >
                <Icon class="text-white/75 text-[1.25rem] mr-1" name="material-symbols:copyright-outline-rounded" ></Icon>
                <div class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
                <Icon class:list={["transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
                    {"group-hover:opacity-100": hasBannerLink}]}
                      name="fa6-solid:arrow-up-right-from-square">
                </Icon>
            </a>}


            <SideBar class="mb-4 row-start-2 row-end-3 col-span-2 lg:row-start-1 lg:row-end-2 lg:col-span-1 lg:max-w-[17.5rem] onload-animation" category={category} currentSlug={currentSlug}></SideBar>

            <main id="swup-container" data-article={String(isPostPage)} class="transition-swup-fade col-span-2 lg:col-span-1 overflow-hidden">
                <div id="content-wrapper" class="onload-animation">
                    <slot></slot>
                    <div class="footer col-span-2 onload-animation hidden lg:block">
                        <Footer></Footer>
                    </div>
                </div>
            </main>

            <!-- Right sidebar: always in the DOM for Swup, content swapped per page -->
            <aside id="right-sidebar" class="xl:row-start-1 xl:row-end-2 xl:col-start-3 xl:max-w-[17.5rem] self-stretch">
                <div class="sidebar-rail sidebar-rail-right">
                    <SidebarToggle client:load side="right" variant="rail" collapseLabel={i18n(I18nKey.collapseRightSidebar)} expandLabel={i18n(I18nKey.expandRightSidebar)} />
                </div>
                <div id="right-sidebar-body" class="sidebar-content">
                    {isPostPage ? (
                        <RightSidebar headings={headings} />
                    ) : (
                        <div id="toc-inner-wrapper" class="hidden"><div id="toc"></div></div>
                    )}
                </div>
            </aside>

            <div class="footer col-span-2 onload-animation block lg:hidden">
                <Footer></Footer>
            </div>
        </div>

        <BackToTop></BackToTop>
<Mascot />
    </div>
</div>

<style is:global>
    #main-panel { margin-top: -2rem; padding-bottom: 1rem; }
    html[data-home="true"] #main-panel { margin-top: 0; padding-top: 2rem; background: var(--page-bg); }
    @media(min-width: 768px) and (min-height: 620px) and (prefers-reduced-motion: no-preference) {
        html[data-home="true"][data-opening-motion="true"]:has(.home-opening:not(.static-opening)) #main-panel { margin-top: -80svh; }
        html[data-home="true"][data-opening-motion="true"]:has(.home-opening:not(.static-opening)) #main-panel::before {
            content: ""; position: absolute; inset: -6rem 0 auto; height: 6rem;
            background: linear-gradient(to bottom, transparent, var(--page-bg)); pointer-events: none;
        }
    }
    #home-opening:empty { display: none; }
    #page-banner { height: clamp(15rem, 32vh, 23rem); position: relative; overflow: hidden; }
    #page-banner.page-banner-empty { height: 0; }
    .page-banner-image { height: 100%; width: 100%; }
    #swup-container { min-width: 0; }
    @media(max-width: 767px) {
        #page-banner { height: 15rem; }
    }
    #right-sidebar { display: none; }
    .sidebar-rail { display: none; }
    .sidebar-collapse-control { position: absolute; right: .65rem; top: .75rem; z-index: 2; }
    @media (min-width: 1024px) {
        #main-grid {
            grid-template-columns: 15rem minmax(0, 1fr);
            grid-template-areas: "left main";
            gap: 1.5rem;
            transition: grid-template-columns 320ms cubic-bezier(.22,.68,.20,1);
        }
        #sidebar { grid-area: left; max-width: none; min-width: 0; position: relative; overflow: clip; }
        #sidebar-content { height: 100%; }
        #swup-container { grid-area: main; width: 100%; max-width: none; justify-self: stretch; }
        html[data-reading="true"] #sidebar-content,
        html[data-reading="true"] #right-sidebar-body {
            width: 15rem;
            transition: opacity 220ms ease, transform 320ms cubic-bezier(.22,.68,.20,1), visibility 0ms;
            overflow-anchor: none;
        }
        html[data-reading="true"] .sidebar-rail { display: block; position: absolute; inset: 0; }
        html[data-reading="true"] #sidebar-sticky :is(series-widget,widget-layout):first-of-type > :is(a,div):first-child { padding-right: 2rem; }
        html[data-reading="true"] #right-sidebar-content .card-base > div:first-child { padding-right: 2rem; }
        html[data-reading="true"][data-left-collapsed="true"] #main-grid {
            grid-template-columns: 1.25rem minmax(0, 1fr);
        }
        html[data-reading="true"][data-left-collapsed="true"] #sidebar-content {
            opacity: 0; transform: translateX(-.75rem); visibility: hidden;
            transition: opacity 180ms ease, transform 320ms cubic-bezier(.22,.68,.20,1), visibility 0ms 220ms;
            pointer-events: none;
        }
    }
    @media (min-width: 1280px) {
        #main-grid.has-rsb {
            grid-template-columns: 15rem minmax(0, 1fr) 15rem;
            grid-template-areas: "left main right";
        }
        #main-grid.has-rsb #right-sidebar { display: block; grid-area: right; max-width: none; min-width: 0; position: relative; overflow: clip; }
        #right-sidebar-body { height: 100%; }
        html[data-reading="true"][data-left-collapsed="true"] #main-grid.has-rsb {
            grid-template-columns: 1.25rem minmax(0, 1fr) 15rem;
        }
        html[data-reading="true"][data-right-collapsed="true"] #main-grid.has-rsb {
            grid-template-columns: 15rem minmax(0, 1fr) 1.25rem;
        }
        html[data-reading="true"][data-right-collapsed="true"] #right-sidebar-body {
            opacity: 0; transform: translateX(.75rem); visibility: hidden;
            transition: opacity 180ms ease, transform 320ms cubic-bezier(.22,.68,.20,1), visibility 0ms 220ms;
            pointer-events: none;
        }
        html[data-reading="true"][data-left-collapsed="true"][data-right-collapsed="true"] #main-grid.has-rsb {
            grid-template-columns: 1.25rem minmax(0, 1fr) 1.25rem;
        }
    }
    @media(prefers-reduced-motion: reduce) {
        #main-grid, .sidebar-content { transition: none !important; }
    }
</style>

</Layout>

---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Mascot from "@components/Mascot.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import RightSidebar from "../components/widget/RightSidebar.astro";
import { siteConfig } from "../config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
	category?: string;
	currentSlug?: string;
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
	category,
	currentSlug,
} = Astro.props;

const isPostPage = headings.length > 0;
const hasBannerCredit =
	siteConfig.banner.enable && siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;

const mainPanelTop = siteConfig.banner.enable
	? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "5.5rem";

const bannerSrc = setOGTypeArticle && banner ? banner : siteConfig.banner.src;
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<div id="top-row" class="z-50 pointer-events-none relative transition-all duration-700 max-w-[var(--page-width)] px-0 md:px-4 mx-auto" class:list={[""]}>
    <div id="navbar-wrapper" class="pointer-events-auto sticky top-0 transition-all">
        <Navbar></Navbar>
    </div>
</div>

<!-- Banner -->
{siteConfig.banner.enable && <div id="banner-wrapper" class={`absolute z-10 w-full transition duration-700 overflow-hidden`} style={`top: -${BANNER_HEIGHT_EXTEND}vh`}>
    <ImageWrapper id="banner" alt="Banner image of the blog" class:list={["object-cover h-full transition duration-700 opacity-0 scale-105"]}
                  src={bannerSrc} position={siteConfig.banner.position}
    >
    </ImageWrapper>
    <div id="banner-tint" class="absolute inset-0 z-10 pointer-events-none"></div>
    <!-- Maple leaf decoration (matches site theme) -->
    <div class="maple-leaves absolute inset-0 z-[12] pointer-events-none select-none overflow-hidden" aria-hidden="true">
        <span class="leaf l1">🍁</span>
        <span class="leaf l2">🍁</span>
        <span class="leaf l3">🍁</span>
        <span class="leaf l4">🍁</span>
        <span class="leaf l5">🍁</span>
    </div>
    <!-- Banner motto, only visible on the home page (see Layout.astro CSS) -->
    <div class="banner-motto absolute inset-0 flex flex-col items-center justify-center z-20 pointer-events-none select-none">
        <div class="text-white/90 font-bold text-5xl md:text-6xl drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)] tracking-widest banner-text-float">
            Code Is Elegant
        </div>
        <div class="text-white/65 text-lg md:text-xl mt-3 drop-shadow-[0_1px_4px_rgba(0,0,0,0.5)] tracking-wider">
            写优雅的代码
        </div>
    </div>
    <!-- Wavy fade into page background -->
    <div class="banner-waves absolute bottom-0 left-0 right-0 z-[15] pointer-events-none h-[10vh] min-h-[3rem] max-h-[9rem] md:h-[14vh]">
        <svg class="w-full h-full block" xmlns="http://www.w3.org/2000/svg" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="geometricPrecision">
            <defs>
                <path id="banner-gentle-wave" d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v48h-352z"></path>
            </defs>
            <g>
                <use href="#banner-gentle-wave" x="48" y="0" style="fill:var(--page-bg);opacity:0.28"></use>
                <use href="#banner-gentle-wave" x="48" y="3" style="fill:var(--page-bg);opacity:0.5"></use>
                <use href="#banner-gentle-wave" x="48" y="5" style="fill:var(--page-bg);opacity:0.7"></use>
                <use href="#banner-gentle-wave" x="48" y="7" style="fill:var(--page-bg);opacity:1"></use>
            </g>
        </svg>
    </div>
</div>}

<!-- Main content -->
<div class="absolute w-full z-30 pointer-events-none" style={`top: var(--main-panel-top, ${mainPanelTop})`}>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative max-w-[var(--page-width)] mx-auto pointer-events-auto">
        <div id="main-grid" class="transition duration-700 w-full left-0 right-0 grid grid-cols-[17.5rem_auto] grid-rows-[auto_1fr_auto] lg:grid-rows-[auto] mx-auto gap-4 px-0 md:px-4">
            <!-- Banner image credit -->
            {hasBannerCredit && <a href={siteConfig.banner.credit.url} id="banner-credit" target="_blank" rel="noopener" aria-label="Visit image source"
                                   class:list={["group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
                                   "px-3 right-4 -top-[3.25rem] bg-black/60 hover:bg-black/70 h-9", {"hover:pr-9 active:bg-black/80": hasBannerLink}]}
            >
                <Icon class="text-white/75 text-[1.25rem] mr-1" name="material-symbols:copyright-outline-rounded" ></Icon>
                <div class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
                <Icon class:list={["transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
                    {"group-hover:opacity-100": hasBannerLink}]}
                      name="fa6-solid:arrow-up-right-from-square">
                </Icon>
            </a>}


            <SideBar class="mb-4 row-start-2 row-end-3 col-span-2 lg:row-start-1 lg:row-end-2 lg:col-span-1 lg:max-w-[17.5rem] onload-animation" category={category} currentSlug={currentSlug}></SideBar>

            <main id="swup-container" class="transition-swup-fade col-span-2 lg:col-span-1 overflow-hidden">
                <div id="content-wrapper" class="onload-animation">
                    <slot></slot>
                    <div class="footer col-span-2 onload-animation hidden lg:block">
                        <Footer></Footer>
                    </div>
                </div>
            </main>

            <!-- Right sidebar: always in the DOM for Swup, content swapped per page -->
            <aside id="right-sidebar" class="xl:row-start-1 xl:row-end-2 xl:col-start-3 xl:max-w-[17.5rem] self-stretch">
                {isPostPage ? (
                    <RightSidebar
                        headings={headings}
                    />
                ) : (
                    <div id="toc-inner-wrapper" class="hidden"><div id="toc"></div></div>
                )}
            </aside>

            <div class="footer col-span-2 onload-animation block lg:hidden">
                <Footer></Footer>
            </div>
        </div>

        <BackToTop></BackToTop>
<Mascot />
    </div>
</div>

<style is:global>
    #right-sidebar {
        width: 0;
        overflow: hidden;
        visibility: hidden;
        position: absolute;
    }
    @media (min-width: 1280px) {
        #main-grid.has-rsb {
            grid-template-columns: 17.5rem 1fr 17.5rem;
        }
        #main-grid.has-rsb #right-sidebar {
            width: auto;
            overflow: visible;
            visibility: visible;
            position: static;
        }
        #main-grid.has-rsb .footer.block.lg\:hidden {
            grid-column: span 3;
        }
    }
</style>

<script>
    function syncRightSidebar() {
        const grid = document.getElementById('main-grid');
        const sb = document.getElementById('right-sidebar');
        if (!grid || !sb) return;
        const hasContent = sb.querySelector('table-of-contents');
        if (hasContent) {
            grid.classList.add('has-rsb');
        } else {
            grid.classList.remove('has-rsb');
        }
    }
    syncRightSidebar();
    document.addEventListener('swup:content:replace', syncRightSidebar);
</script>

</Layout>
